# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (Render / Local)
DATABASE_URL="postgresql://username:password@localhost:5432/recycleconnect_db?sslmode=require"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Cloudinary Credentials (Media Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Paystack Payment & Wallet Gateway
PAYSTACK_SECRET_KEY="my_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="my_paystack_public_key"

# Termii SMS / OTP Provider (Optional for Dev / Mock Mode)
TERMII_API_KEY="your_termii_api_key"